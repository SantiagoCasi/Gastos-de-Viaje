@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<h1 class="text-danger">Error.</h1>
<h2 class="text-danger">Ocurrió un error al procesar la solicitud.</h2>

@if (Model.ShowRequestId)
{
    <p>
        <strong>Id. de solicitud:</strong> <code>@Model.RequestId</code>
    </p>
}

<h3>Modo de desarrollo</h3>
<p>
    Cambiar al entorno <strong>Development</strong> muestra información más detallada sobre el error ocurrido.
</p>
<p>
    <strong>El entorno de Development no debe habilitarse en aplicaciones desplegadas.</strong>
    Puede exponer información sensible de las excepciones a los usuarios finales.
    Para depurar localmente, habilitá el entorno <strong>Development</strong> configurando la variable
    de entorno <strong>ASPNETCORE_ENVIRONMENT</strong> en <strong>Development</strong> y reiniciando la app.
</p>
