@model GastosDeViaje.ViewModels.GastoFormViewModel
@{
    var sesionViaje = (GastosDeViaje.Models.SesionViaje)ViewBag.SesionViaje;
    ViewData["Title"] = $"Cargar gasto en {sesionViaje.Nombre}";
}

<h1>@ViewData["Title"]</h1>

<div class="row">
    <div class="col-12 col-md-6">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="SesionViajeId" />

            <div class="mb-3">
                <label asp-for="Monto" class="form-label"></label>
                <input asp-for="Monto" type="number" step="0.01" min="0.01" inputmode="decimal" class="form-control" autofocus />
                <span asp-validation-for="Monto" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Fecha" class="form-label"></label>
                <input asp-for="Fecha" class="form-control" />
                <span asp-validation-for="Fecha" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Lugar" class="form-label"></label>
                <input asp-for="Lugar" class="form-control" />
                <span asp-validation-for="Lugar" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Motivo" class="form-label"></label>
                <input asp-for="Motivo" class="form-control" />
                <span asp-validation-for="Motivo" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ParticipanteId" class="form-label"></label>
                <select asp-for="ParticipanteId" class="form-select" asp-items="ViewBag.Participantes">
                    <option value="">-- Elegir --</option>
                </select>
                <span asp-validation-for="ParticipanteId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="MetodoPago" class="form-label"></label>
                <select asp-for="MetodoPago" class="form-select" asp-items="ViewBag.MetodosPago"></select>
                <span asp-validation-for="MetodoPago" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Guardar gasto</button>
            <a asp-action="Index" asp-route-sesionViajeId="@Model.SesionViajeId" class="btn btn-outline-secondary">Cancelar</a>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
