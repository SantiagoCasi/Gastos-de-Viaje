@model GastosDeViaje.Models.Gasto
@{
    var participante = (GastosDeViaje.Models.Participante)ViewBag.Participante;
    ViewData["Title"] = "Eliminar gasto";
}

<h1>@ViewData["Title"]</h1>

<p>¿Confirmás que querés eliminar este gasto?</p>

<dl class="row">
    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Monto)</dt>
    <dd class="col-sm-9 monto">@Model.Monto.ToString("C2")</dd>

    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Fecha)</dt>
    <dd class="col-sm-9">@Model.Fecha.ToShortDateString()</dd>

    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Lugar)</dt>
    <dd class="col-sm-9">@Model.Lugar</dd>

    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Motivo)</dt>
    <dd class="col-sm-9">@Model.Motivo</dd>

    <dt class="col-sm-3">Pagado por</dt>
    <dd class="col-sm-9">@participante.Nombre</dd>
</dl>

<form asp-action="Delete">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Eliminar</button>
    <a asp-action="Index" asp-route-sesionViajeId="@Model.SesionViajeId" class="btn btn-outline-secondary">Cancelar</a>
</form>
