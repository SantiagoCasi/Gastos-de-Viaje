@model GastosDeViaje.Models.SesionViaje
@using GastosDeViaje.Models
@using GastosDeViaje.Models.Enums

@{
    ViewData["Title"] = "Detalle de la sesión de viaje";
    var liquidaciones = (List<Liquidacion>)ViewBag.Liquidaciones;
    var hayGastosPendientes = (bool)ViewBag.HayGastosPendientes;
    var sesionAbierta = Model.Estado == EstadoSesion.Abierta;
}

<h1>@ViewData["Title"]</h1>

@if (TempData["Error"] is string error)
{
    <div class="alert alert-warning" role="alert">@error</div>
}

<dl class="row">
    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Nombre)</dt>
    <dd class="col-sm-9">@Html.DisplayFor(model => model.Nombre)</dd>

    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Estado)</dt>
    <dd class="col-sm-9">@Html.DisplayFor(model => model.Estado)</dd>

    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.FechaCreacion)</dt>
    <dd class="col-sm-9">@Model.FechaCreacion.ToShortDateString()</dd>

    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.FechaCierre)</dt>
    <dd class="col-sm-9">@(Model.FechaCierre?.ToShortDateString() ?? "—")</dd>

    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Moneda)</dt>
    <dd class="col-sm-9">@Html.DisplayFor(model => model.Moneda)</dd>
</dl>

<div class="mb-4">
    <a asp-controller="Participante" asp-action="Index" asp-route-sesionViajeId="@Model.Id" class="btn btn-outline-secondary">Participantes</a>
    <a asp-controller="Gasto" asp-action="Index" asp-route-sesionViajeId="@Model.Id" class="btn btn-outline-secondary">Gastos</a>
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Editar</a>
    <a asp-action="Index" class="btn btn-link">Volver al listado</a>
</div>

@if (sesionAbierta)
{
    <h2>Liquidar cuentas</h2>
    <p>Reparte los gastos pendientes en partes iguales entre los participantes (RF08, RF09).</p>
    <div class="mb-4">
        <form asp-controller="Liquidacion" asp-action="Break" asp-route-sesionViajeId="@Model.Id" class="d-inline">
            <button type="submit" class="btn btn-primary" @(hayGastosPendientes ? "" : "disabled")>Hacer break (liquidación parcial)</button>
        </form>
        <form asp-controller="Liquidacion" asp-action="Finalizar" asp-route-sesionViajeId="@Model.Id" class="d-inline">
            <button type="submit" class="btn btn-danger" @(hayGastosPendientes ? "" : "disabled")>Finalizar sesión</button>
        </form>
        @if (!hayGastosPendientes)
        {
            <div class="form-text">No hay gastos pendientes para liquidar.</div>
        }
    </div>
}
else
{
    <p><em>Esta sesión está cerrada: no admite nuevos gastos ni liquidaciones.</em></p>
}

<h2>Liquidaciones anteriores</h2>
@if (!liquidaciones.Any())
{
    <p>Todavía no se calculó ninguna liquidación en esta sesión.</p>
}
else
{
    <ul class="list-group">
        @foreach (var liquidacion in liquidaciones)
        {
            <li class="list-group-item d-flex justify-content-between align-items-center">
                <span>
                    @(liquidacion.Tipo == TipoLiquidacion.Parcial ? "Break" : "Liquidación final")
                    del @liquidacion.Fecha.ToShortDateString()
                    — @liquidacion.TotalGastado.ToString("C2")
                </span>
                <a asp-controller="Liquidacion" asp-action="Detalle" asp-route-id="@liquidacion.Id" class="btn btn-sm btn-outline-secondary">Ver detalle</a>
            </li>
        }
    </ul>
}
