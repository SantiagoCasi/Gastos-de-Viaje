@model IEnumerable<GastosDeViaje.Models.Participante>
@{
    var sesionViaje = (GastosDeViaje.Models.SesionViaje)ViewBag.SesionViaje;
    ViewData["Title"] = $"Participantes de {sesionViaje.Nombre}";
}

<h1>@ViewData["Title"]</h1>

<p>
    <a asp-action="Create" asp-route-sesionViajeId="@sesionViaje.Id" class="btn btn-primary">Agregar participante</a>
    <a asp-controller="SesionViaje" asp-action="Details" asp-route-id="@sesionViaje.Id" class="btn btn-outline-secondary">Volver a la sesión</a>
</p>

@if (!Model.Any())
{
    <p>Todavía no hay participantes en esta sesión.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>@Html.DisplayNameFor(model => model.Nombre)</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@Html.DisplayFor(modelItem => item.Nombre)</td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Editar</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Eliminar</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
